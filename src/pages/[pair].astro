---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FormatsCard from '../components/FormatsCard.astro';
import CodeBoxes from '../components/CodeBoxes.astro';
import Conversions from '../components/Conversions.astro';
import Faq from '../components/Faq.astro';
import { PAIRS, pairBySlug, pairLabel, type Pair } from '../data/pairs';
import { SAMPLE_COLORS } from '../data/formats';
import { SITE } from '../data/site';
import { convert } from '../lib/color';
import { inline } from '../lib/text';
import { swatchStyle } from '../lib/ui';

export function getStaticPaths() {
  return PAIRS.map((pair) => ({ params: { pair: pair.slug }, props: { pair } }));
}

interface Props { pair: Pair }
const { pair } = Astro.props;
const url = `${SITE.url}/${pair.slug}`;
const reverse = PAIRS.find((p) => p.from === pair.to && p.to === pair.from);
const showCode = pair.to === 'oklch' || pair.from === 'oklch';

// Sample table: ten familiar colors written in the source notation, converted by the same engine as the tool.
const samples = SAMPLE_COLORS.map((s) => {
  const base = convert(s.hex)!;
  const source = base[pair.from];
  return { name: s.name, swatch: base.solidHex, source, target: convert(source)![pair.to] };
});

const updated = new Date(pair.updated + 'T00:00:00Z');
const updatedText = updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `Hexvert ${pairLabel(pair)} Converter`,
    url,
    description: pair.description,
    applicationCategory: 'DesignApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Color converter', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: `${pairLabel(pair)} converter`, item: url },
    ],
  },
];
---

<Base title={pair.title} description={pair.description} path={`/${pair.slug}`} jsonLd={jsonLd} bodyStyle={swatchStyle(convert(pair.example)!)} ogImage={`/og/${pair.slug}.png`}>
  <Hero h1={`${pairLabel(pair)} converter`} label={pair.inputLabel} initial={pair.example} result={{ key: pair.to, label: pair.toName }} />

  <main id="main" class="wrap stack pull-up">
    <FormatsCard initial={pair.example} heading="Every other format too" target={pair.to} />

    <section class="section">
      <nav aria-label="Breadcrumb">
        <ol class="crumbs soft"><li><a href="/">Color converter</a> /</li><li aria-current="page">{pairLabel(pair)}</li></ol>
      </nav>
      <p class="h3" style="font-weight:500;max-width:720px" set:html={inline(pair.lead)} />
      <h2 class="h2">{pair.stepsHeading}</h2>
      <ol class="steps">
        {pair.steps.map((s) => <li set:html={inline(s)} />)}
      </ol>
      <div class="worked">
        <p set:html={inline(pair.worked.intro)} />
        <ul>{pair.worked.lines.map((l) => <li set:html={inline(l)} />)}</ul>
        <p><strong set:html={inline(pair.worked.result)} /></p>
      </div>
    </section>

    <section class="section">
      <h2 class="h2">Common colors from {pair.fromName} to {pair.toName}</h2>
      <div class="table-scroll">
        <table>
          <thead><tr><th scope="col">Color</th><th scope="col">{pair.fromName}</th><th scope="col">{pair.toName}</th></tr></thead>
          <tbody>
            {samples.map((s) => (
              <tr>
                <td><span class="dot" aria-hidden="true" style={`background:${s.swatch}`} />{s.name}</td>
                <td class="mono">{s.source}</td>
                <td class="mono">{s.target}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <h2 class="h2">Common mistakes</h2>
      <div class="grid-qa">
        {pair.mistakes.map((m) => (
          <div class="qa"><h3 class="h3">{m.title}</h3><p class="muted" set:html={inline(m.body)} /></div>
        ))}
      </div>
    </section>

    {showCode && <CodeBoxes initial={pair.example} />}

    <Faq items={pair.faqs} />

    {reverse && (
      <p class="h3" style="font-weight:500">Going the other way? Use the <a href={`/${reverse.slug}`}>{pairLabel(reverse)} converter</a>.</p>
    )}

    <Conversions current={pair.slug} heading="Other conversions" />

    <p class="soft">Last reviewed {updatedText}. Every value on this page is checked against the converter on each build. <a href="/accuracy">How we test accuracy</a>.</p>
  </main>
</Base>
