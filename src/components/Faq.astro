---
import { inline } from '../lib/text';
interface Props { items: Array<{ q: string; a: string }>; heading?: string }
const { items, heading = 'Questions people ask' } = Astro.props;
---

<section id="faq" class="section">
  <h2 class="h2">{heading}</h2>
  <div class="grid-qa">
    {items.map((item) => (
      <div class="qa">
        <h3 class="h3">{item.q}</h3>
        <p class="muted" set:html={inline(item.a)} />
      </div>
    ))}
  </div>
</section>
