---
interface Props {
  /** On the home page the nav points at sections of the page itself */
  home?: boolean;
}
const { home = false } = Astro.props;
const links = home
  ? [
      { href: '#formats', label: 'Formats' },
      { href: '#contrast', label: 'Contrast' },
      { href: '/bulk', label: 'Bulk converter' },
      { href: '#conversions', label: 'All conversions' },
      { href: '#faq', label: 'Questions' },
    ]
  : [
      { href: '/', label: 'Color converter' },
      { href: '/bulk', label: 'Bulk converter' },
      { href: '/#conversions', label: 'All conversions' },
      { href: '/accuracy', label: 'Accuracy' },
    ];
---

<header class="wrap site-header">
  <a class="brand" href="/" aria-label="Hexvert home">
    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20">
      <circle cx="10" cy="10" r="8.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
      <path d="M10 1.5a8.5 8.5 0 0 1 0 17z" fill="currentColor"></path>
    </svg>
    hexvert
  </a>
  <nav class="site-nav" aria-label="Main">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
</header>
